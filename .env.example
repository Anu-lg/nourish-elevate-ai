# ─── NutriFlex AI — Environment Variables Example ────────────────────────────
# Copy this file to .env and fill in your real values.
# Never commit the real .env file to Git.
#
# Usage: cp .env.example .env

# ─── Google Gemini API ────────────────────────────────────────────────────────
# Required. Used by the server to generate personalised diet and workout plans.
# Get a free API key at: https://aistudio.google.com/apikey
# Used in:
#   - src/lib/diet-generation.server.ts
#   - src/lib/workout-generation.server.ts
GEMINI_API_KEY=your_gemini_api_key_here

# ─── Dev Server (optional) ───────────────────────────────────────────────────
# Enables TanStack Start bundled dev mode so server functions work with vite dev.
# Set to "true" when running locally. Not needed in production.
LOVABLE_FEATURE_BUNDLED_DEV=true
